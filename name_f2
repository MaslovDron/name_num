    $evenCount = 0;
    $oddCount = 0;
    
    foreach ([$nameNumber, $soulNumber, $personalityNumber, $karmicNumber] as $num) {
        if ($num % 2 == 0) $evenCount++; else $oddCount++;
    }
    
